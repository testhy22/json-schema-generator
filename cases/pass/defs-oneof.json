{
  "description": "$defs + oneOf 合法形态：恰好命中一个分支",
  "expect": "pass",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/actor-event.json",
    "title": "操作事件",
    "description": "按 principalType 分派两类操作者，二选一",
    "type": "object",
    "properties": {
      "actor": {
        "description": "操作者主体，人类用户或系统服务",
        "oneOf": [
          { "$ref": "#/$defs/humanActor" },
          { "$ref": "#/$defs/serviceActor" }
        ]
      }
    },
    "required": ["actor"],
    "additionalProperties": false,
    "$defs": {
      "humanActor": {
        "type": "object",
        "description": "人类用户操作者",
        "properties": {
          "principalType": {
            "type": "string",
            "description": "固定为 user",
            "const": "user"
          },
          "userId": {
            "type": "string",
            "description": "用户唯一 ID"
          }
        },
        "required": ["principalType", "userId"],
        "additionalProperties": false
      },
      "serviceActor": {
        "type": "object",
        "description": "系统服务操作者",
        "properties": {
          "principalType": {
            "type": "string",
            "description": "固定为 service",
            "const": "service"
          },
          "serviceName": {
            "type": "string",
            "description": "服务名"
          }
        },
        "required": ["principalType", "serviceName"],
        "additionalProperties": false
      }
    }
  },
  "example": {
    "actor": {
      "principalType": "service",
      "serviceName": "order-settlement"
    }
  }
}
